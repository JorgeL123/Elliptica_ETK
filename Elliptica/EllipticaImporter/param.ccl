# Parameter definitions for thorn EllipticaImporter

SHARES: ADMBase

EXTENDS KEYWORD initial_data
{
  "EllipticaImporter" :: "Elliptica initial data"
}

EXTENDS KEYWORD initial_lapse
{
  "EllipticaImporter" :: "Elliptica initial lapse"
}

EXTENDS KEYWORD initial_shift
{
  "EllipticaImporter" :: "Elliptica initial shift"
}

EXTENDS KEYWORD initial_dtlapse
{
  "EllipticaImporter" :: "Elliptica initial dtlapse"
}

EXTENDS KEYWORD initial_dtshift
{
  "EllipticaImporter" :: "Elliptica initial dtshift"
}

PRIVATE:

CCTK_STRING type "Type of system to import from Elliptica"
{
  "BBH"  :: "binary black hole"
  "BH"   :: "single black hole"
  "BNS"  :: "binary neutron star"
  "NS"   :: "single neutron star"
  "BHNS" :: "black hole neutron star"
} "BBH"

CCTK_STRING checkpoint_path "Full path to the Elliptica checkpoint file"
{
  ".*" :: "any string"
} ""
