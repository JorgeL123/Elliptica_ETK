# Schedule definitions for thorn EllipticaImporter

STORAGE: ADMBase::metric
STORAGE: ADMBase::curv
STORAGE: ADMBase::lapse
STORAGE: ADMBase::shift
STORAGE: HydroBase::rho
STORAGE: HydroBase::eps
STORAGE: HydroBase::press
STORAGE: HydroBase::vel

SCHEDULE EllipticaImporter AT initial
{
  LANG: C
  WRITES:
    ADMBase::metric(everywhere),
    ADMBase::curv(everywhere),
    ADMBase::lapse(everywhere),
    ADMBase::shift(everywhere),
    HydroBase::rho(everywhere),
    HydroBase::eps(everywhere),
    HydroBase::press(everywhere),
    HydroBase::vel(everywhere)
  SYNC:
    ADMBase::metric,
    ADMBase::curv,
    ADMBase::lapse,
    ADMBase::shift,
    HydroBase::rho,
    HydroBase::eps,
    HydroBase::press,
    HydroBase::vel
  READS:
    grid::x, grid::y, grid::z
  OPTIONS: meta
} "Import initial data from Elliptica"
