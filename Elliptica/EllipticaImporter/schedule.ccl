# Schedule definitions for thorn EllipticaImporter

if (CCTK_EQUALS (initial_data,    "EllipticaImporter") ||
    CCTK_EQUALS (initial_lapse,   "EllipticaImporter") ||
    CCTK_EQUALS (initial_shift,   "EllipticaImporter") ||
    CCTK_EQUALS (initial_dtlapse, "EllipticaImporter") ||
    CCTK_EQUALS (initial_dtshift, "EllipticaImporter"))
{
  SCHEDULE EllipticaImporter_check_parameters AT paramcheck
  {
    LANG: C
  } "Check parameters"

  if (CCTK_EQUALS (type, "BBH"))
  {
    SCHEDULE EllipticaImporter IN ADMBase_InitialData
    {
      LANG: C
    } "Set up binary black hole initial data"
  }
  if (CCTK_EQUALS (type, "BH"))
  {
    SCHEDULE EllipticaImporter IN ADMBase_InitialData
    {
      LANG: C
    } "Set up black hole initial data"
  }
  if (CCTK_EQUALS (type, "BNS"))
  {
    SCHEDULE EllipticaImporter IN HydroBase_Initial BEFORE ADMBase_PostInitial
    {
      LANG: C
    } "Set up binary neutron star initial data"
  }
  if (CCTK_EQUALS (type, "NS"))
  {
    SCHEDULE EllipticaImporter IN HydroBase_Initial BEFORE ADMBase_PostInitial
    {
      LANG: C
    } "Set up neutron star initial data"
  }
  if (CCTK_EQUALS (type, "BHNS"))
  {
    SCHEDULE EllipticaImporter IN HydroBase_Initial BEFORE ADMBase_PostInitial
    {
      LANG: C
    } "Set up black hole neutron star initial data"
  }
}
