# Configuration for Elliptica_ID_Reader
# The library itself is fetched and built by get-source.sh (see make.code.defn).
# This variable is what EllipticaImporter (and any other consumer thorn) should
# use to find the built include/ and lib/ directories.

ELLIPTICA_ID_READER_DIR := $(CCTK_HOME)/arrangements/Elliptica/Elliptica_ID_Reader/src/Elliptica_ID_Reader_src
