  SphericalSurface::sf_valid
  SphericalSurface::sf_info
  SphericalSurface::sf_radius
  SphericalSurface::sf_origin
  SphericalSurface::sf_coordinate_descriptors
"


IOASCII::out1D_every                    = 256
IOASCII::out1D_d                        = no
IOASCII::out1D_x                        = yes
IOASCII::out1D_y                        = no
IOASCII::out1D_z                        = yes

IOASCII::out1D_vars                     = "
  ML_CCZ4::ML_log_confac
  ML_CCZ4::ML_trace_curv
  ADMBase::lapse
  ADMBase::shift
  ADMBase::metric
  ADMBase::curv
  ML_ADMConstraints::ML_Ham
  IllinoisGRMHD::rho_b
  IllinoisGRMHD::P
  IllinoisGRMHD::vx
  IllinoisGRMHD::vy
  IllinoisGRMHD::vz
"


IOHDF5::out_every                       = 200000

IOHDF5::out_vars                        = "
  ML_CCZ4::ML_log_confac
"


IOHDF5::out2D_every                     = 512

IOHDF5::out2D_vars                      = "
  ML_CCZ4::alpha
  ML_CCZ4::phi
  ML_CCZ4::trK
  CarpetReduce::weight
  Grid::coordinates
  HydroBase::rho
  HydroBase::vel
  HydroBase::eps
  ADMBase::lapse
  ADMBase::shift
  ADMBase::metric
  ML_ADMConstraints::ML_Ham
  WeylScal4::Psi4r
  WeylScal4::Psi4i
"


########################################################################
# CHECKPOINT
########################################################################

CarpetIOHDF5::checkpoint                       = "yes"
CarpetIOHDF5::use_reflevels_from_checkpoint    = "yes"

IOUtil::abort_on_io_errors                     = "yes"
IOUtil::checkpoint_on_terminate                = "yes"

IO::checkpoint_every_walltime_hours            = 29

IOUtil::checkpoint_keep                        = 2

IO::recover                                    = "autoprobe"

IO::checkpoint_dir                             = "../CHECKPOINTS"
IO::recover_dir                                = "../CHECKPOINTS"

IOUtil::out_dir                                = "./data/"

IOUtil::strict_io_parameter_check               = "yes"
IO::parfile_write                              = "copy"


########################################################################
# TRACK NS
########################################################################

VolumeIntegrals_GRMHD::NumIntegrals             = 4
VolumeIntegrals_GRMHD::VolIntegral_out_every    = 128
VolumeIntegrals_GRMHD::outVolIntegral_dir      = "volume_integration"
VolumeIntegrals_GRMHD::verbose                 = 0


# Integral 1: volume
VolumeIntegrals_GRMHD::Integration_quantity_keyword[1] = "one"


# Integral 2: NS centre of mass
VolumeIntegrals_GRMHD::Integration_quantity_keyword[2] = "centerofmass"

VolumeIntegrals_GRMHD::volintegral_sphere__center_x_initial[2] = {{NS_POS_X}}
VolumeIntegrals_GRMHD::volintegral_sphere__center_y_initial[2] = {{NS_POS_Y}}

VolumeIntegrals_GRMHD::volintegral_inside_sphere__radius[2] = 13

VolumeIntegrals_GRMHD::amr_centre__tracks__volintegral_inside_sphere[2] = 1


# Integral 3: NS volume
VolumeIntegrals_GRMHD::Integration_quantity_keyword[3] = "one"

VolumeIntegrals_GRMHD::volintegral_sphere__center_x_initial[3] = {{NS_POS_X}}
VolumeIntegrals_GRMHD::volintegral_sphere__center_y_initial[3] = {{NS_POS_Y}}

VolumeIntegrals_GRMHD::volintegral_inside_sphere__radius[3] = 13


# Integral 4: rest mass
VolumeIntegrals_GRMHD::Integration_quantity_keyword[4] = "restmass"


########################################################################
# TRACK BH
########################################################################

PunctureTracker::initial_x[0]                    = {{BH_POS_X}}
PunctureTracker::initial_y[0]                    = {{BH_POS_Y}}

PunctureTracker::track[0]                        = "yes"
PunctureTracker::verbose                         = "no"

PunctureTracker::which_surface_to_store_info[0] = 0


########################################################################
# GW
########################################################################

WeylScal4::offset                       = 1.0e-8
WeylScal4::fd_order                     = "4th"
WeylScal4::verbose                      = 0


Multipole::nradii                       = 5
multipole::out_every                    = 256

Multipole::radius[0]                    = 100
Multipole::radius[1]                    = 200
Multipole::radius[2]                    = 300
Multipole::radius[3]                    = 400
Multipole::radius[4]                    = 500

Multipole::ntheta                       = 120
Multipole::nphi                         = 240

Multipole::variables                    = "
  WeylScal4::Psi4r{sw=-2 cmplx='WeylScal4::Psi4i' name='psi4'}
"

Multipole::l_max                        = 8
Multipole::output_hdf5                  = yes


########################################################################
# QUASI-LOCAL MEASURES
########################################################################
#
# Surface 2 = BH apparent horizon
# Surface 3 = common/remnant apparent horizon
#
# Include both so that QLM can provide quantities for both horizons.
########################################################################

QuasiLocalMeasures::interpolator         = "Lagrange polynomial interpolation"
QuasiLocalMeasures::interpolator_options = "order=4"

QuasiLocalMeasures::spatial_order         = 4

QuasiLocalMeasures::num_surfaces          = 2

QuasiLocalMeasures::surface_index[0]      = 2
QuasiLocalMeasures::surface_index[1]      = 3

Quasilocalmeasures::output_vtk_every      = 64


########################################################################
# CONVERT TO HYDROBASE
########################################################################

Convert_to_HydroBase::Convert_to_HydroBase_every = 4
